# Copy to .env. No secrets are required: the Elexon Insights API is public/keyless.
DATA_MODE=auto            # auto = real files if present else labelled SYNTHETIC sample | real | sample
FETCH_ON_STARTUP=false    # true = download real data from Elexon on boot if data/real is empty
PERIOD_START=2026-01-01
PERIOD_END=2026-01-31
CUTOFF_HOUR=9             # day-ahead decision cutoff, local clock on D-1 (ASSUMPTION, configurable)
CUTOFF_MINUTE=0
CUTOFF_TZ=Europe/London
MAPE_MIN_ACTUAL_MW=100
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_S=30
HTTP_RETRIES=4
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
# Frontend (build-time, Vercel): URL of the deployed backend
VITE_API_BASE_URL=
